PORT=4010
# Internal Prometheus scrape port (must differ from PORT). Set to 0 to disable. Not exposed via Traefik.
METRICS_PORT=4011
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required: same secret as app (JWT_SECRET); used to verify MCP JWTs. At least 32 characters.
JWT_SECRET=your-secret-at-least-32-chars

# Comma-separated list of origins allowed for CORS (e.g. https://a9t.io,http://localhost:3000)
ALLOWED_ORIGINS=https://a9t.io
# Reverse-proxy hops to trust for client IPs (1 behind Traefik; 0 when exposed directly).
TRUST_PROXY=0
